service:
  name: ${SERVICE_NAME}
  identifier: ${SERVICE_IDENTIFIER}
  description: ${SERVICE_DESCRIPTION}
  orgIdentifier: ${ORG_IDENTIFIER}
  projectIdentifier: ${PROJECT_IDENTIFIER}
  serviceDefinition:
    type: AwsLambda
    spec:
      manifests:
        - manifest:
            identifier: function_definition
            type: AwsLambdaFunctionDefinition
            spec:
              store:
                type: Harness
                spec:
                  files:
                    - ${FUNCTION_DEFINITION_PATH}
      artifacts:
        primary:
          primaryArtifactRef: lambda_zip
          sources:
            - identifier: lambda_zip
              type: AmazonS3
              spec:
                connectorRef: ${CONNECTOR_REF}
                region: ${AWS_REGION}
                bucketName: ${ARTIFACTS_BUCKET}
                filePath: ${ARTIFACT_KEY}
